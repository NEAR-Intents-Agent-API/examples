# Copy to `.env` and fill in. `.env` is gitignored; never commit real keys.

# ---------------------------------------------------------------------------------------------
# API access — the only values you truly need. Create the partner API key in the partner portal
# (https://partners.near-intents.org). The portal shows it once; it expires after 365 days. To
# rotate, create a new key and revoke the old one. Treat it as an opaque string.
# The key stays on your backend; never ship it to a browser. Both are required: the URL is an
# HTTPS origin (plain HTTP only for localhost), with no path.
# ---------------------------------------------------------------------------------------------
NEAR_INTENTS_AGENT_API_URL=https://api.agentsonintents.com
NEAR_INTENTS_AGENT_API_KEY=

# ---------------------------------------------------------------------------------------------
# Owner wallet (NEAR). The owner signs privileged actions: creating an agent, editing rules,
# issuing grants, approving, deleting. The hosted API is mainnet: use a dedicated account that
# holds little value, and a FullAccess key of that account.
# ---------------------------------------------------------------------------------------------
AGENT_OWNER_ACCOUNT_ID=
AGENT_OWNER_PRIVATE_KEY=

# ---------------------------------------------------------------------------------------------
# Owner wallet (EVM). Only needed for `03:evm-*` examples. A plain private key is enough: the
# API derives a `0s` NEAR account from the public key and sponsors its deployment.
# ---------------------------------------------------------------------------------------------
AGENT_OWNER_EVM_PRIVATE_KEY=

# ---------------------------------------------------------------------------------------------
# Example inputs
# ---------------------------------------------------------------------------------------------
# Agent to read or act on (from `02:create-agent`).
AGENT_ID=
# NEAR Intents account that receives transfers/withdrawals in examples.
AGENT_RECIPIENT=
# NEAR account of the service the agent proves its identity to (`07-native-accounts`). Never
# intents.near or intents.far: the API refuses to sign for the NEAR Intents contracts.
AGENT_SIGN_RECIPIENT=
# An address on Base the owner lists in `native.evm.sign_intent.withdrawals` (`07-native-accounts`).
AGENT_WITHDRAW_ADDRESS=
# A Solana address that `destinations` allows, for `solana/sign-transfer` (`07-native-accounts`).
AGENT_SOLANA_RECIPIENT=
# Optional 1Click partner key for the quotes `07:sign-intent-deposit` requests. Backend only.
ONE_CLICK_API_KEY=
# Transparency log origin operation proofs must name (`11-verify-operations`). Pin it yourself:
# a deployment's log is `<API host>/log`. Empty means the host of NEAR_INTENTS_AGENT_API_URL.
AGENT_LOG_ORIGIN=
# Where the log's tiles are read from, over HTTPS, to verify receipts (`11:payment-receipt`). Empty
# means the hosted log (https://log.agentsonintents.com/); set it when your API is another deployment.
AGENT_LOG_URL=
# Checkpoint witness public key (64 hex characters) the same step pins. Empty means the hosted
# API's key (api.agentsonintents.com); set it when your API is another deployment.
AGENT_WITNESS_KEY=
# Asset id (from `01:list-tokens`) that examples move.
AGENT_TOKEN=nep141:wrap.near
# Amount in the token's smallest unit (atomic), not whole tokens.
AGENT_TRANSFER_AMOUNT=1
# A second token used by the swap example, and the quote asset of the limit order.
AGENT_SWAP_TO=nep141:usdt.tether-token.near
# Limit price for `05:limit-order`: AGENT_SWAP_TO per one whole AGENT_TOKEN, a plain decimal. It
# is market data, so there is no default; the order must be worth at least 0.1 USD, so raise
# AGENT_TRANSFER_AMOUNT (the order's quantity) too.
AGENT_LIMIT_PRICE=

# ---------------------------------------------------------------------------------------------
# Safety and behavior. Every example that changes state or spends refuses to run unless
# AGENT_ALLOW_WRITES=true. Reads always work.
# ---------------------------------------------------------------------------------------------
AGENT_ALLOW_WRITES=false
# Also execute the live action in examples that default to dry-run/read-only.
AGENT_EXECUTE=false
# Require owner approval in the example policy (shows the PENDING_APPROVAL flow).
AGENT_REQUIRE_APPROVAL=false
# How many agents `02:multiple-agents` creates.
AGENT_COUNT=2
# RPC used for NEP-366 delegate signing.
AGENT_NEAR_RPC_URL=https://free.rpc.fastnear.com
# RPC used for the recent blockhash in `07:solana`.
AGENT_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
